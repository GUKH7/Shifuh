NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL da API do robô WhatsApp usada pelo painel em Configurações > Conexão WhatsApp.
# Exemplo: https://whatsapp-bot.seudominio.com
NEXT_PUBLIC_WHATSAPP_BOT_API_URL=

# Base URL server-side usada para enviar mensagens automáticas quando o status do pedido muda.
# Pode apontar para a mesma URL acima, sem expor token no browser.
WHATSAPP_BOT_API_URL=
WHATSAPP_BOT_SEND_MESSAGE_PATH=/send-message
WHATSAPP_BOT_API_TOKEN=
