NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credenciais oficiais do app iFood no Developer Portal.
# Fluxo centralizado: grantType=client_credentials.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_API_BASE_URL=https://merchant-api.ifood.com.br
# Opcional: sobrescreva somente se o iFood informar outro endpoint de autenticação.
IFOOD_AUTH_URL=
# Polling oficial de eventos. Por padrão buscamos pedidos FOOD e filtramos por merchant no header.
IFOOD_POLLING_CATEGORIES=FOOD
IFOOD_POLLING_GROUPS=
IFOOD_POLLING_TYPES=
# Use true somente se o app for integrador logístico, conforme documentação do iFood.
IFOOD_POLLING_EXCLUDE_HEARTBEAT=false

# Protege rotas de tarefas agendadas, como /api/cron/ifood/orders.
# Na Vercel, configure o mesmo valor em CRON_SECRET para validar o header Authorization: Bearer.
CRON_SECRET=

# Base URL da API do robô WhatsApp usada pelo painel em Configurações > Conexão WhatsApp.
# Exemplo: https://whatsapp-bot.seudominio.com
NEXT_PUBLIC_WHATSAPP_BOT_API_URL=

# Base URL server-side usada para enviar mensagens automáticas quando o status do pedido muda.
# Pode apontar para a mesma URL acima, sem expor token no browser.
WHATSAPP_BOT_API_URL=
WHATSAPP_BOT_SEND_MESSAGE_PATH=/send-message
WHATSAPP_BOT_API_TOKEN=
