NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Assina os links privados e persistentes de acompanhamento de pedidos.
# Gere um valor aleatorio com pelo menos 32 bytes e mantenha somente no servidor.
ORDER_TRACKING_SECRET=

# Credenciais oficiais do app iFood no Developer Portal.
# Fluxo centralizado: grantType=client_credentials.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_API_BASE_URL=https://merchant-api.ifood.com.br
# Opcional: sobrescreva somente se o iFood informar outro endpoint de autenticacao.
IFOOD_AUTH_URL=
# Polling oficial de eventos. Por padrao buscamos pedidos FOOD e filtramos por merchant no header.
IFOOD_POLLING_CATEGORIES=FOOD
IFOOD_POLLING_GROUPS=
IFOOD_POLLING_TYPES=
# Use true somente se o app for integrador logistico, conforme documentacao do iFood.
IFOOD_POLLING_EXCLUDE_HEARTBEAT=false

# Protege rotas de tarefas agendadas, como /api/cron/ifood/orders.
# Na Vercel, configure o mesmo valor em CRON_SECRET para validar o header Authorization: Bearer.
CRON_SECRET=

# Base URL server-side da API do robo WhatsApp. Nunca exponha como NEXT_PUBLIC_*.
# Exemplo: https://whatsapp-bot.seudominio.com
WHATSAPP_BOT_API_URL=
WHATSAPP_BOT_SEND_MESSAGE_PATH=/send-message
# Token compartilhado com a API do robo. Todas as chamadas usam Authorization: Bearer.
WHATSAPP_BOT_API_TOKEN=
# Tempo maximo de chamada para status, restart e envio de mensagens.
WHATSAPP_BOT_TIMEOUT_MS=10000
