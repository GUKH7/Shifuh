# Token compartilhado entre o Shifuh/Vercel e a API WhatsApp.
# Obrigatorio: sem ele o processo deve recusar a inicializacao.
WHATSAPP_BOT_API_TOKEN=
# Opcional. Quando definido, substitui WHATSAPP_BOT_API_TOKEN nas rotas principais.
# Para a integracao atual do Shifuh, mantenha o mesmo segredo nos dois lados.
WHATSAPP_MAIN_API_TOKEN=

# A API deve ouvir apenas no loopback. Exponha-a externamente somente por um
# reverse proxy HTTPS local (Nginx/Caddy) e mantenha a porta 3001 fechada no OCI/UFW.
WHATSAPP_BIND_HOST=127.0.0.1
WHATSAPP_PORT=3001
WHATSAPP_ALLOW_PUBLIC_BIND=false
# Use loopback quando o proxy HTTPS local encaminhar X-Forwarded-For.
WHATSAPP_TRUST_PROXY=loopback

# Limites defensivos. Ajuste apenas com base em volume real observado.
WHATSAPP_AUTH_RATE_LIMIT_MAX=120
WHATSAPP_AUTH_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_SEND_RATE_LIMIT_MAX=60
WHATSAPP_SEND_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_RESTART_RATE_LIMIT_MAX=5
WHATSAPP_RESTART_RATE_LIMIT_WINDOW_MS=300000
WHATSAPP_ECONOAPP_RATE_LIMIT_MAX=120
WHATSAPP_ECONOAPP_RATE_LIMIT_WINDOW_MS=60000
