# Reverse proxy HTTPS obrigatório para a API WhatsApp.
# O processo Node deve permanecer exclusivamente em 127.0.0.1:3001.
# As zonas abaixo adicionam um segundo rate limit antes da requisição chegar ao Express.

limit_req_zone $binary_remote_addr zone=whatsapp_general:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=whatsapp_send:10m rate=1r/s;
limit_req_zone $binary_remote_addr zone=whatsapp_restart:10m rate=6r/m;

server {
    listen 443 ssl http2;
    server_name whatsapp-bot.seudominio.com;

    ssl_certificate /etc/letsencrypt/live/whatsapp-bot.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/whatsapp-bot.seudominio.com/privkey.pem;

    client_max_body_size 16k;
    limit_req_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /health {
        limit_req zone=whatsapp_general burst=10 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location = /status {
        limit_req zone=whatsapp_general burst=20 nodelay;
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location = /send-message {
        limit_req zone=whatsapp_send burst=15 nodelay;
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location = /restart {
        limit_req zone=whatsapp_restart burst=2 nodelay;
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location = /econoapp {
        limit_req zone=whatsapp_general burst=20 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location ^~ /econoapp/ {
        limit_req zone=whatsapp_general burst=20 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    # Nenhuma outra rota do processo Node é publicada pelo proxy.
    location / {
        return 404;
    }
}
